<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /buller/
    
    # Allow existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>
